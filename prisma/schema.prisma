// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth Core Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  studentId     String?   @unique
  emailVerified Boolean?  @default(false)
  image         String?
  role          String    @default("user") // user, admin
  phone         String?
  recoveryEmail String?
  program       String?
  level         Int?
  residenceStatus String?
  company       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  contacts      Contact[]
  uploadedResources Resource[] @relation("ResourceUploader")
  resourceRequests ResourceRequest[]
  complaints    Complaint[]
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("notice")
  published   Boolean  @default(false)
  pinned      Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, pinned])
  @@index([publishedAt])
}

model Complaint {
  id          String   @id @default(cuid())
  type        String
  subject     String
  details     String
  anonymous   Boolean  @default(false)
  status      String   @default("new")
  response    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, startsAt])
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  caption     String?
  category    String   @default("community")
  imageUrl    String
  imageWidth  Int?
  imageHeight Int?
  publicId    String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([approved, category])
}

model Program {
  id          String   @id @default(cuid())
  name        String   @unique
  college     String?
  active      Boolean  @default(true)
  courses     Course[]
  resources   Resource[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  level       Int
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  resources   Resource[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([programId, code, level])
  @@index([programId, level])
}

model Resource {
  id             String   @id @default(cuid())
  title          String
  description    String?
  type           String   // lecture-slide, note, past-question
  fileUrl        String
  cloudinaryPublicId String?
  fileName       String
  fileFormat     String
  fileSize       Int?
  academicYear   String?
  semester       String?
  level          Int
  approved       Boolean  @default(false)
  approvedAt     DateTime?
  programId      String
  courseId       String
  uploadedById   String
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy     User     @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  requests       ResourceRequest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, approved])
  @@index([programId, level])
  @@index([courseId])
}

model ResourceRequest {
  id          String    @id @default(cuid())
  title       String
  details     String
  type        String
  status      String    @default("pending")
  userId      String
  resourceId  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String    @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime?
  updatedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  expiresAt            DateTime?
  password             String?
  createdAt            DateTime?
  updatedAt            DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
  
  @@unique([identifier, value])
}

// Business Logic Models
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("Discovery") // Discovery, Design, Development, Live
  progress    Int       @default(0)
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  category    String?   // E-Commerce, Corporate, Web App, etc.
  technologies String?  // Comma-separated list of technologies
  imageUrl    String?   // Project thumbnail/cover image
  liveUrl     String?   // Live project URL
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNumber String @unique
  amount      Float
  status      String   @default("Pending") // Pending, Paid, Overdue, Cancelled
  dueDate     DateTime?
  paidDate    DateTime?
  description String?
  items       String?  // JSON string of invoice line items
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@index([status])
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String
  budget      String?
  message     String
  status      String   @default("New") // New, Read, Replied
  userId      String?  // Optional - track if user is logged in
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// Blog Models
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   // Rich text/HTML content
  coverImage  String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  authorId    String?
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
  tags        BlogTag[]
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  
  @@index([slug])
  @@index([published])
  @@index([categoryId])
  @@index([createdAt])
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  posts       BlogPost[]
  createdAt   DateTime @default(now())
}

// Portfolio/Work Models
model PortfolioProject {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  content      String?  // Rich text for case study
  coverImage   String?
  images       String?  // JSON array of image URLs
  category     String?  // E-Commerce, Corporate, Web App, etc.
  technologies String?  // Comma-separated list
  client       String?
  liveUrl      String?
  githubUrl    String?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([published])
  @@index([featured])
}

// Analytics Models (simplified - removed PageView)
model UserActivity {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  action      String   // login, signup, logout, form_submit, click, etc.
  category    String?  // auth, navigation, interaction, conversion
  label       String?  // Additional context
  value       String?  // JSON data for the action
  ipAddress   String?
  userAgent   String?
  os          String?
  browser     String?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([sessionId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
}

model AnalyticsSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      String?
  ipAddress   String?
  userAgent   String?
  os          String?
  browser     String?
  device      String?
  country     String?
  city        String?
  landingPage String?
  referrer    String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  duration    Int?     // Session duration in seconds
  pageCount   Int      @default(0)
  
  @@index([userId])
  @@index([startedAt])
}
